# Demos originais (.dem) -- pesadas (30-200MB+), baixadas do FACEIT (expiram em 30
# dias), nunca devem ir pro git.
data/raw/
demos/

# Tabelas brutas do awpy (rounds/kills/damages/ticks em parquet) -- ticks sozinho
# passa de 1 milhão de linhas por partida. Só as métricas já calculadas em
# data/processed/ vão pro repositório (são leves e é o que o dashboard usa).
data/interim/

# Páginas de partida geradas por build_web_page.py (arquivo único, pra abrir
# local). O que é publicado é o site em docs/, gerado por build_site.py -- manter
# as duas cópias no git seria ~900KB duplicados por partida.
dashboard/web/match_*.html

# PNGs dos radares: o painel lê a imagem embutida no .json ao lado, então o PNG
# solto é só pra conferir a olho. Versionar os dois dobraria o peso à toa.
assets/radars/*.png

# Radares baixados à mão, insumo do prepare_radar.py para os mapas que não estão
# na instalação do CS2 (Boulder, Debris, Fachwerk, Shelter). São imagens de
# terceiros e só servem depois que existir uma demo naquele mapa pra calibrar.
CS2 Radares/

__pycache__/
*.pyc
.pytest_cache/
.streamlit/

.venv/
venv/

# Rede de segurança: demo em QUALQUER pasta fica fora. Uma demo de 300MB
# entrando por engano trava o push (o GitHub recusa acima de 100MB) e fica no
# histórico para sempre.
*.dem
*.dem.gz
*.dem.bz2
*.zip
*.rar
*.7z
.env
*.log
.ipynb_checkpoints/

# Site GERADO por scripts/build_site.py. Não é versionado: cada reconstrução
# regravava as 52 páginas (~130MB) e o histórico guardava todas as versões para
# sempre -- era 54% do repositório quando foi purgado (2026-09-19). O site é
# publicado pelo GitHub Actions (.github/workflows/pages.yml), que o gera a
# partir do código e de data/processed/ e entrega como artefato do Pages: nada
# disso entra em branch nenhum.
docs/
